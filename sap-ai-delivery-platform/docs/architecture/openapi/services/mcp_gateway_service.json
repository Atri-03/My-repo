  "components": {
    "schemas": {
      "GetArtefactResponse": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "version": {
            "type": "integer",
            "title": "Version"
          },
          "status": {
            "type": "string",
            "title": "Status"
          },
          "content": {
            "additionalProperties": true,
            "type": "object",
            "title": "Content"
          }
        },
        "type": "object",
        "required": [
          "id",
          "version",
          "status",
          "content"
        ],
        "title": "GetArtefactResponse"
      },
      "GetWorkflowStateResponse": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "current_state": {
            "type": "string",
            "title": "Current State"
          },
          "started_at": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Started At"
          },
          "completed_at": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Completed At"
          }
        },
        "type": "object",
        "required": [
          "id",
          "current_state"
        ],
        "title": "GetWorkflowStateResponse"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "ListSourcesResponse": {
        "properties": {
          "sources": {
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "type": "array",
            "title": "Sources"
          }
        },
        "type": "object",
        "required": [
          "sources"
        ],
        "title": "ListSourcesResponse"
      },
      "SearchDocumentsRequest": {
        "properties": {
          "query": {
            "type": "string",
            "title": "Query"
          },
          "source_types": {
            "anyOf": [
              {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Source Types"
          },
          "top": {
            "type": "integer",
            "title": "Top",
            "default": 10
          },
          "search_mode": {
            "type": "string",
            "title": "Search Mode",
            "default": "hybrid"
          }
        },
        "type": "object",
        "required": [
          "query"
        ],
        "title": "SearchDocumentsRequest"
      },
      "SearchDocumentsResponse": {
        "properties": {
          "results": {
            "items": {
              "$ref": "#/components/schemas/SearchDocumentsResult"
            },
            "type": "array",
            "title": "Results"
          }
        },
        "type": "object",
        "required": [
          "results"
        ],
        "title": "SearchDocumentsResponse"
      },
      "SearchDocumentsResult": {
        "properties": {
          "chunk_id": {
            "type": "string",
            "title": "Chunk Id"
          },
          "source_uri": {
            "type": "string",
            "title": "Source Uri"
          },
          "source_type": {
            "type": "string",
            "title": "Source Type"
          },
          "text": {
            "type": "string",
            "title": "Text"
          },
          "score": {
            "type": "number",
            "title": "Score",
            "default": 0.0
          },
          "is_dead_link": {
            "type": "boolean",
            "title": "Is Dead Link",
            "default": false
          }
        },
        "type": "object",
        "required": [
          "chunk_id",
          "source_uri",
          "source_type",
          "text"
        ],
        "title": "SearchDocumentsResult"
      },
      "SubmitReviewDecisionRequest": {
        "properties": {
          "review_cycle_id": {
            "type": "string",
            "title": "Review Cycle Id"
          },
          "decided_by": {
            "type": "string",
            "title": "Decided By"
          },
          "decision": {
            "type": "string",
            "title": "Decision"
          }
        },
        "type": "object",
        "required": [
          "review_cycle_id",
          "decided_by",
          "decision"
        ],
        "title": "SubmitReviewDecisionRequest"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
