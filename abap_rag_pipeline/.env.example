# Azure OpenAI (GPT-4o)
AZURE_OPENAI_API_KEY=your-azure-openai-key
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_API_VERSION=2024-05-01-preview
AZURE_OPENAI_DEPLOYMENT=gpt-4o

# ChromaDB (local persistent store for POC)
CHROMA_PERSIST_DIR=./data/chroma
CHROMA_COLLECTION_NAME=fs_ts_examples

# SAP ADT REST API
ADT_BASE_URL=https://your-sap-host:44300
ADT_SAP_CLIENT=100
ADT_AUTH_MODE=basic          # basic | snc (snc is a TODO stub)
ADT_USERNAME=your-sap-user
ADT_PASSWORD=your-sap-password
ADT_TARGET_PACKAGE=ZRAG_POC

# Microsoft Teams Graph API (NOT implemented yet — TODO stub only)
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=

# App / tracker
TRACKER_DB_PATH=./data/tracker/tracker.json
OUTPUT_DIR=./data/output
